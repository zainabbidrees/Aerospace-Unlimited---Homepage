{
  "$meta": {
    "project": "Aerospace Unlimited",
    "stage": "Draft 1 — Phase A",
    "docs": "../DESIGN-TOKENS.md",
    "reference": {
      "url": "https://agentwork.com/",
      "extractedAt": "2026-07-27",
      "note": "System adapted from this reference; brand identity is our own. Accent shifted, mono role and stock-status semantics added."
    },
    "contentRule": "The phrase 'No China Sourcing' must never appear in any copy, label, or mockup."
  },

  "font": {
    "sans": "\"Mona Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Helvetica, Arial, sans-serif",
    "mono": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", monospace"
  },

  "weight": {
    "body": 425,
    "caption": 450,
    "mono": 500,
    "medium": 550,
    "bold": 650
  },

  "text": {
    "display": "3rem",
    "h1": "2rem",
    "h2": "1.5rem",
    "h3": "1.25rem",
    "body": "1rem",
    "small": "0.875rem",
    "caption": "0.8125rem",
    "part": "0.9375rem"
  },

  "leading": {
    "display": 1.15,
    "mid": 1.35,
    "body": 1.5,
    "small": 1.43
  },

  "tracking": {
    "display": "-0.03em",
    "heading": "-0.02em",
    "body": "0.005em",
    "caption": "0.01em"
  },

  "color": {
    "bg": "#fdfdfc",
    "surface": "#ffffff",
    "surfaceSubtle": "#f9f9f8",
    "surfaceSunken": "#f1f0ef",
    "border": "#e2e1de",
    "borderStrong": "#cfceca",
    "ink": "#21201c",
    "inkMuted": "#63635e",
    "inkFaint": "#82827c",
    "accent": "#e05a00",
    "accentHover": "#c44e00",
    "accentContrast": "#ffffff",
    "accentSurface": "#fff0e6",
    "accentBorder": "#ffd0b0",
    "stockIn": "#208368",
    "stockInSurface": "#e6f7ed",
    "stockLimited": "#9e6c00",
    "stockLimitedSurface": "#fefce9",
    "stockOut": "#d13415",
    "stockOutSurface": "#feebe7"
  },

  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "2.5rem",
    "8": "3rem",
    "9": "4rem",
    "10": "5rem",
    "11": "7.5rem"
  },

  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "pill": "999px"
  },

  "elevation": {
    "ring": "0 0 0 0.5px #cfceca",
    "1": "0 0 0 0.5px #cfceca",
    "2": "0 0 0 0.5px #cfceca, 0 2px 8px -2px rgba(0, 0, 0, 0.08)",
    "3": "0 0 0 0.5px #cfceca, 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1)"
  },

  "container": {
    "page": "1200px",
    "prose": "720px",
    "narrow": "588px"
  },

  "motion": {
    "duration": "150ms",
    "ease": "cubic-bezier(0, 0, 0.2, 1)"
  }
}
